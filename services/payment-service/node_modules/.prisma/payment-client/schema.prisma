// Prisma schema for payment-service

// Generator for Prisma Client
generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/payment-client"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

// Datasource configuration
datasource db {
  provider = "postgresql"
  url      = env("PAYMENT_DATABASE_URL")
  schemas  = ["payment"]
}

// Enum for payment status
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUND_REQUESTED
  REFUND_APPROVED
  REFUND_REJECTED
  REFUNDED

  @@schema("payment")
}

// Payment model
model Payment {
  id               String        @id @default(uuid())
  bookingId        String        @unique
  userId           String
  amount           Float
  currency         String        @default("vnd")
  status           PaymentStatus @default(PENDING)
  vnpTransactionNo String?
  vnpTxnRef        String?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@schema("payment")
}

model IdempotencyKey {
  scope      String
  key        String
  bookingId  String?
  statusCode Int?
  response   Json?
  createdAt  DateTime @default(now())

  @@id([scope, key])
  @@index([bookingId])
  @@schema("payment")
}

model ProcessedEvent {
  id          String   @id @default(uuid())
  consumer    String
  messageId   String
  eventType   String?
  routingKey  String?
  processedAt DateTime @default(now())

  @@unique([consumer, messageId])
  @@index([consumer, processedAt])
  @@map("processed_events")
  @@schema("payment")
}
