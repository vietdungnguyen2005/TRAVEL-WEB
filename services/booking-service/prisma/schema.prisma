generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/booking-client"
  previewFeatures = ["multiSchema"]
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("BOOKING_DATABASE_URL")
  schemas  = ["booking"]
}

model Booking {
  id         String        @id @default(uuid())
  roomId     String
  userId     String
  checkIn    DateTime
  checkOut   DateTime
  numberOfGuests Int
  totalPrice     Decimal       @db.Decimal(10, 2)
  status         BookingStatus @default(PENDING)
  holdExpiresAt  DateTime?
  paymentStatus  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("bookings")
  @@schema("booking")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  ON_HOLD

  @@schema("booking")
}

model Outbox {
  id            String   @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  published     Boolean  @default(false)
  publishedAt   DateTime?
  lockedAt      DateTime?
  lockExpiresAt DateTime?
  lockedBy      String?
  publishAttempts Int     @default(0)
  lastError     String?
  createdAt     DateTime @default(now())

  @@index([published, createdAt])
  @@index([published, lockExpiresAt, createdAt])
  @@map("outbox")
  @@schema("booking")
}

model ProcessedEvent {
  id         String   @id @default(uuid())
  consumer   String
  messageId  String
  eventType  String?
  routingKey String?
  processedAt DateTime @default(now())

  @@unique([consumer, messageId])
  @@index([consumer, processedAt])
  @@map("processed_events")
  @@schema("booking")
}