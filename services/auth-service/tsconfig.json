{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "outDir": "dist",
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*",
        "../../infra/scripts/load-env-profile.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/http/routes/**/*"
    ]
}