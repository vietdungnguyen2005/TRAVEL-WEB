# IMPORTANT: Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Supabase PostgreSQL Connection
# Get from: https://supabase.com → Settings → Database → Connection String
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional: Supabase public keys (if using Supabase client-side features)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-supabase-anon-key"

# ============================================
# AUTHENTICATION
# ============================================
# NextAuth.js Configuration
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional - for social login)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# PAYMENT INTEGRATION
# ============================================
# Stripe Payment Gateway (International)
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# Get webhook secret: stripe listen --forward-to localhost:3000/api/payment/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# VNPay Payment Gateway (Vietnam - Optional)
# Get from: https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE="your-vnpay-tmn-code"
VNPAY_HASH_SECRET="your-vnpay-hash-secret"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# ============================================
# IMAGE STORAGE
# ============================================
# Cloudinary CDN
# Get from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================
# EMAIL SERVICE
# ============================================
# Resend Email API
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@yourdomain.com"

# ============================================
# APPLICATION SETTINGS
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Travel Booking System"

# ============================================
# SECURITY & RATE LIMITING
# ============================================
# Cron Job Secret (for /api/cron/* endpoints)
# Generate: openssl rand -base64 32
CRON_SECRET="your-random-secret-key-for-cron-jobs"

# Upstash Redis (for production rate limiting)
# Sign up at: https://upstash.com
# Optional: Falls back to in-memory rate limiting if not set
UPSTASH_REDIS_REST_URL="https://your-redis-project.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# ============================================
# OPTIONAL SERVICES
# ============================================
# Sentry Error Tracking (Recommended for production)
# Get from: https://sentry.io
# SENTRY_DSN="https://..."
# NEXT_PUBLIC_SENTRY_DSN="https://..."

# Google Analytics (Optional)
# NEXT_PUBLIC_GA_ID="G-..."
