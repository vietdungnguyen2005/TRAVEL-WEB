{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": "./",
        "jsx": "react-jsx",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": [
            "node",
            "jest"
        ],
        "paths": {
            "@travel-web/contracts": [
                "./packages/contracts/src"
            ],
            "@travel-web/shared": [
                "./packages/shared/src"
            ],
            "@/*": [
                "./apps/web/src/*"
            ]
        }
    },
    "include": [
        "apps/web/src/**/*",
        "packages/contracts/**/*",
        "apps/web/src/components/components",
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}