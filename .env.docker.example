# Local Docker profile (DB-per-service inside docker-compose)

ENV_PROFILE=docker
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Travel Booking System"

# Service databases (host ports, for running services on your machine)
AUTH_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/auth_db"
BOOKING_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/booking_db"
ROOM_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/room_db"
PAYMENT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5435/payment_db"
REVIEW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5436/review_db"
NOTIFICATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5437/notification_db"
BLOG_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5438/blog_db"

# Infra
RABBITMQ_URL="amqp://localhost"
REDIS_URL="redis://127.0.0.1:6379"

# OAuth / JWT / keys
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
JWT_ACCESS_SECRET="change-me"

# Stripe / VNPay etc
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
