{
  "name": "travel-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --concurrency=12",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "migrate": "node infra/scripts/migrate-all.js",
    "start": "next start",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "postinstall": "echo 'postinstall: skipped root prisma generate (use per-service prisma)'",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:seed:auth": "npm run db:seed --workspace=@travel-web/auth-service"
  },
  "prisma": {
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
