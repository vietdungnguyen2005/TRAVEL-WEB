    "@supabase/supabase-js": "^2.93.3",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.36.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.8.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express-rate-limit": "^8.2.1",
    "lucide-react": "^0.562.0",
    "morgan": "^1.10.1",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-email": "^5.1.0",
    "react-hook-form": "^7.69.0",
