# Supabase profile (cloud DB is the source of truth)

ENV_PROFILE=supabase
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Travel Booking System"

# IMPORTANT:
# Use ONE Supabase project, but keep DB-per-service isolation by schema/role.
# Each service should have its own URL (schema/user restricted).
#
# Example format (recommended: use pooler/Direct URL for migrations when needed):
# postgresql://<user>:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=<service_schema>

AUTH_DATABASE_URL="postgresql://<auth_user>:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=auth"
BOOKING_DATABASE_URL="postgresql://<booking_user>:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=booking"
ROOM_DATABASE_URL="postgresql://<room_user>:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=room"
PAYMENT_DATABASE_URL="postgresql://<payment_user>:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=payment"
REVIEW_DATABASE_URL="postgresql://<review_user>:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=review"
NOTIFICATION_DATABASE_URL="postgresql://<notification_user>:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=notification"
BLOG_DATABASE_URL="postgresql://<blog_user>:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=blog"

# (Optional) Supabase client keys for web
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Infra (still local for dev unless you host them)
RABBITMQ_URL="amqp://localhost"
REDIS_URL="redis://127.0.0.1:6379"

# OAuth / JWT / keys
JWT_ACCESS_SECRET="change-me"
